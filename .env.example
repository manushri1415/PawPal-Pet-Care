# Copy to .env and fill in as needed: `copy .env.example .env` (Windows) or
# `cp .env.example .env` (macOS/Linux). Every value below is optional — the
# app runs with zero configuration using the mock LLM provider (no API key,
# fully reproducible), which is also what tests and demo_pawpal_ai.py use.

# --- LLM provider ---------------------------------------------------------
# "mock" (default) needs no key and is fully deterministic. Set to "claude"
# to use the live Anthropic API for extraction/Q&A.
PAWPAL_LLM_PROVIDER=mock
PAWPAL_MODEL=claude-haiku-4-5
# Required only when PAWPAL_LLM_PROVIDER=claude.
ANTHROPIC_API_KEY=

# --- RAG / extraction tuning ----------------------------------------------
PAWPAL_RETRIEVAL_K=4
PAWPAL_MAX_ATTEMPTS=3
PAWPAL_EVIDENCE_THRESHOLD=0.5
PAWPAL_DUE_SOON_DAYS=30

# --- Storage ------------------------------------------------------------------
# "sqlite" (default): one local file at PAWPAL_DB_PATH -- development, tests, Docker.
# "dynamodb": the single table named by PAWPAL_DYNAMODB_TABLE (production on AWS;
# credentials and region come from the standard AWS SDK chain).
PAWPAL_STORAGE_BACKEND=sqlite
PAWPAL_DYNAMODB_TABLE=
# Point the DynamoDB backend at a local DynamoDB (e.g. http://localhost:8001).
PAWPAL_DYNAMODB_ENDPOINT=

# --- Storage paths ----------------------------------------------------------
PAWPAL_DB_PATH=data/pawpal.db
PAWPAL_LOG_PATH=logs/app.log

# --- Logging ------------------------------------------------------------------
# "file" writes the structured event log to PAWPAL_LOG_PATH (rotating, 1 MB x 3).
# "stdout" writes the same redacted JSON lines to standard output. Unset picks
# stdout automatically on AWS Lambda (where CloudWatch captures stdout and the
# filesystem is read-only) and the file everywhere else.
PAWPAL_LOG_DESTINATION=

# --- Visitor sessions -------------------------------------------------------
# Every visitor without the owner key gets a private, seeded demo sandbox,
# identified by an HttpOnly cookie. It is deleted this many hours after it was
# created (clamped to 1..168).
PAWPAL_DEMO_TTL_HOURS=48
# Mark the session cookie Secure (HTTPS only). Leave off for http://localhost;
# the AWS deployment turns it on.
PAWPAL_COOKIE_SECURE=

# --- Owner space ------------------------------------------------------------
# Shared secret (sent as the X-PawPal-Owner-Key header) that opens the
# persistent owner space. Only the owner space ever uses Claude; every demo
# visitor extracts and asks with the free rule-based model, so a public visitor
# can never run up API costs. Blank means there is no owner space (a request
# with a key gets 503). A wrong key gets 401. Never reuse ANTHROPIC_API_KEY here.
PAWPAL_OWNER_KEY=

# --- Claude client limits (owner space) -------------------------------------
# Unset keeps the Anthropic SDK defaults. Behind API Gateway's 30 s limit the
# AWS deployment sets a short timeout and no SDK retries (PawPal's own retry
# loop is PAWPAL_MAX_ATTEMPTS) so an extraction always answers in time.
PAWPAL_LLM_TIMEOUT_SECONDS=
PAWPAL_LLM_MAX_RETRIES=
