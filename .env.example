# PawPal AI configuration. Copy to `.env` and adjust as needed.
# NOTE: the whole app, its tests, and the evaluation harness run with NO key
# in the default "mock" provider. A key is only needed to process brand-new
# documents with the real Claude model (PAWPAL_LLM_PROVIDER=claude).

# --- LLM provider ---
# "mock"   -> deterministic canned outputs (no key, powers demo/tests/eval)
# "claude" -> real Anthropic API (requires ANTHROPIC_API_KEY below)
PAWPAL_LLM_PROVIDER=mock
PAWPAL_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=

# --- Retrieval / agent knobs ---
PAWPAL_RETRIEVAL_K=4
PAWPAL_MAX_ATTEMPTS=3
PAWPAL_EVIDENCE_THRESHOLD=0.5

# --- Reminder logic ---
PAWPAL_DUE_SOON_DAYS=30

# --- Paths (defaults are fine) ---
PAWPAL_DB_PATH=data/pawpal.db
PAWPAL_CHROMA_PATH=data/chroma
PAWPAL_LOG_PATH=logs/app.log
